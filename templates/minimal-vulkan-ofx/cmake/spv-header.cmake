# SPDX-License-Identifier: BSD-3-Clause
# Turns <input>.spv into a header with a byte array, so the bundle carries the
# shader inside the .ofx and not as a file next to it.
#
# Run as: cmake -DSPV=<file> -DOUTPUT=<file> -DNAME=<symbol> -P spv-header.cmake
#
# Embedding rather than shipping the .spv is a packaging choice with a measured
# consequence: with the shader inside the module there is no path to resolve, no
# Contents/Resources lookup and no way for a copied installation to lose it. The
# cost is that changing the shader relinks the plug-in, which is what the build
# graph already does.

if(NOT EXISTS "${SPV}")
  message(FATAL_ERROR "spv-header: no SPIR-V at '${SPV}'")
endif()

file(READ "${SPV}" hex HEX)
string(LENGTH "${hex}" hexLength)
math(EXPR bytes "${hexLength} / 2")
if(bytes LESS 4)
  message(FATAL_ERROR "spv-header: '${SPV}' is ${bytes} bytes, which is not SPIR-V")
endif()

string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," octets "${hex}")
string(REGEX REPLACE "((0x..,){16})" "\\1\n    " wrapped "${octets}")
string(REGEX REPLACE "((0x..,){16})" "\\1\n    " wrapped "${wrapped}")

file(WRITE "${OUTPUT}"
"// Generated by cmake/spv-header.cmake from ${SPV}. Do not edit.
//
// ${bytes} bytes, ${hexLength} hex digits. The plug-in hands this to
// vkCreateShaderModule; nothing reads a .spv at run time.
#pragma once

namespace vkgain {
static const unsigned char ${NAME}[] = {
    ${wrapped}
};
} // namespace vkgain
")
