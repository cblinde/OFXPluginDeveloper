$ # do the two new kernel bodies survive a real CUDA compiler?
$ command -v clang clang++ nvcc
  # nothing: no clang either, so `clang -x cuda` was not an option here, and the
  # Windows machine is not reachable from this cell (no shell there).
# There is no root (no_new_privs), so the toolkit came from NVIDIA's Ubuntu 24.04
# repository and was unpacked with dpkg -x, the way valgrind and cppcheck were
# (see valgrind-cppcheck.log for that note in full):
#   cuda-nvcc-12-8 12.8.93-1        cuda-nvvm-12-8 12.8.93-1
#   cuda-crt-12-8 12.8.93-1         cuda-cudart-12-8 12.8.90-1
#   cuda-cudart-dev-12-8 12.8.90-1  cuda-cccl-12-8 12.8.90-1
#   cuda-driver-dev-12-8 12.8.90-1
$ nvcc --version
Cuda compilation tools, release 12.8, V12.8.93

$ nvcc -std=c++17 -arch=sm_89 -DOFXPLUGIN_WITH_CUDA=1 --ptx -o /tmp/kernel.ptx src/Kernel.cu
  exit=0, 4 entries in the PTX:
  .entry ...GainKernelRGBA32FVec4PKfPfiixx6float4
  .entry ...GainKernelRGBA32FScalarPKfPfiixx6float4
  .entry ...GainKernelRGBA16FHalf4PK6__halfPS0_iixx7__half2S4_
  .entry ...GainKernelRGBA8EPKhPhiixx6float4

$ # the instruction mix the kernels promise, counted in their PTX entries
  GainKernelRGBA16FHalf4: 2 ld.global.nc.u32, 2 st.global.u32, 8 cvt.f32.f16, 4 mul.f32
  GainKernelRGBA8:        4 ld.global.nc.u8,  4 st.global.u8,  4 cvt.rn.f32.u16,
                          4 mul.f32, 4 cvt.rni.s32.f32, 4 min.s32, 4 max.s32
  # cvt.rni is round-to-nearest-even-or-integer, the byte rule; min/max is the clamp.

$ nvcc -std=c++17 -arch=sm_89 -DOFXPLUGIN_WITH_CUDA=1 -c -o /tmp/kernel.o src/Kernel.cu
  exit=0
$ nm /tmp/kernel.o | grep -E 'LaunchGain|WaitFor|StatusMessage'
  T LaunchGainRGBA16F
  T LaunchGainRGBA32F
  T LaunchGainRGBA8
  T StatusMessage
  T WaitForDefaultStream

$ nvcc -std=c++17 -arch=sm_89 -DOFXPLUGIN_WITH_CUDA=1 -cubin -Xptxas -v -o /tmp/kernel.cubin src/Kernel.cu
  GainKernelRGBA8      : 0 bytes stack frame, 0 bytes spill stores/loads, 16 registers
  GainKernelRGBA16FHalf4: 0 bytes stack frame, 0 bytes spill stores/loads, 18 registers
  GainKernelRGBA32FScalar: 14 registers
  GainKernelRGBA32FVec4  : 14 registers

$ # and the plug-in as a whole, with the CUDA path enabled
