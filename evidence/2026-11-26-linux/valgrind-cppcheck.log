$ uname -sr; ldd --version | head -1
Linux 7.0.0-38-generic
ldd (Ubuntu GLIBC 2.39-0ubuntu8.12) 2.39

# This container is an unprivileged Ubuntu 24.04 with no sudo (no_new_privs),
# so the packages were fetched from archive.ubuntu.com and unpacked with
# dpkg -x. Two compiled-in paths then had to point into the unpacked tree:
#   cppcheck  FILESDIR  /usr/lib/x86_64-linux-gnu/cppcheck  (reads std.cfg from it)
#   valgrind            /usr/lib/debug                     (reads libc6-dbg from it)
# Both were replaced byte-for-byte with a writable path of the same length,
# which is what a real `apt-get install` does by putting the files there.
$ dpkg-deb -f *.deb Package Version | paste - -
