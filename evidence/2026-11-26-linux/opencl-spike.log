# The kernel compiler was there (Compiler Available: Yes in opencl-pocl.log) but its
# headers were not: Ubuntu ships share/pocl/include (pocl_types.h, _kernel.h,
# opencl-c.h) in libpocl2-common, and the earlier dpkg -x set had unpacked the
# bitcode from libpocl2t64 but not that package. Fixed by unpacking it too, which
# is what apt does by Depends:
$ dpkg -x /tmp/pocl-common.deb .validation/cl

  OPENCL_LOADER_LIB=.validation/cl/usr/lib/x86_64-linux-gnu/libOpenCL.so.1 \
  OCL_ICD_VENDORS=.validation/cl/etc/OpenCL/vendors ./tools/opencl-spike.sh
